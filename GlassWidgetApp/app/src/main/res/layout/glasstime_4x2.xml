<!-- v0.20 «Стеклянное время» 4×2 (и 4×3, v0.30). tag PA: одна или две строки — что крупнее при текущем размере. Каждая цифра — отдельное view со своим жидким стеклом
     (GlassDigitsClock): HWUI держит стекло по содержимому, только пока левый край view на экране. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glasstime_root"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.artemiy.glasstest.GlassDigitsClock
        android:id="@+id/glasstime_text"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:tag="PA"/>
</FrameLayout>
