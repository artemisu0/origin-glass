<!-- v0.16 «Стеклянные часы» 2×2: слой GlassBgView (живое жидкое стекло в хосте, режим clear) + время и дата поверх.
     TextClock разрешён в RemoteViews и обновляется сам — без сервиса и будильников. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_root"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <com.artemiy.glasstest.GlassBgView
        android:id="@+id/clock_glass"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/glass_bg_none"
        android:tag="auto"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="h:mm"
            android:fontFamily="sans-serif-thin"
            android:textSize="58sp" android:textColor="#FFFFFFFF"
            android:includeFontPadding="false"
            android:shadowColor="#40000000" android:shadowRadius="10"/>

        <TextClock
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format24Hour="EEEE, d MMMM" android:format12Hour="EEEE, d MMMM"
            android:fontFamily="sans-serif"
            android:textSize="14sp" android:textColor="#E6FFFFFF"
            android:maxLines="1" android:ellipsize="end"
            android:shadowColor="#40000000" android:shadowRadius="8"/>
    </LinearLayout>
</FrameLayout>
